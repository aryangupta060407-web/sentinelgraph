NODE_ENV=development
PORT=3000

# Graph mode: set exactly one live adapter or leave both blank for demo mode.
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=FraudGraph
TIGERGRAPH_TOKEN=
TIGERGRAPH_MCP_URL=
TIGERGRAPH_MCP_TOKEN=
TIGERGRAPH_MCP_TIMEOUT_MS=12000

# Server-side LLM reasoning through the Manus Forge/OpenAI-compatible endpoint.
# The model receives bounded graph-grounded context only; it cannot bypass policy.
LLM_REASONING_ENABLED=false
LLM_MODEL=gpt-5-mini
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Controlled evidence-provider boundary. Blank means the explicit demo provider.
# A configured URL must be an approved integration; the backend does not invent live verification.
EVIDENCE_PROVIDER_URL=
EVIDENCE_PROVIDER_TOKEN=

# Demo-only controls. Demo write-back is always reported as simulated.
DEMO_MODE=true
DEMO_EXTERNAL_RESPONSE=deterministic

# No vector database is used. Retrieval is graph-grounded: TigerGraph/MCP
# -> bounded evidence ledger -> relevance context -> LLM reasoning.
